rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function ownUser(userId) { return signedIn() && request.auth.uid == userId; }
    match /users/{userId} {
      allow read: if ownUser(userId);
      allow create: if ownUser(userId)
        && request.resource.data.plan == 'free'
        && request.resource.data.price == 0
        && request.resource.data.admin == false
        && request.resource.data.subscriptionStatus == 'free'
        && request.resource.data.features.atsFeedbackUnlocked == false
        && request.resource.data.features.optimizerEnabled == false
        && !request.resource.data.keys().hasAny(['stripeCustomerId', 'stripeSubscriptionId', 'stripePriceId', 'activeUntil']);
      allow update: if ownUser(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'language', 'targetCountry', 'interfaceLanguage', 'userStyleSample', 'useStyleSample', 'useAutoLinkedInBooster', 'jobSearchPreferences',
        'agbAccepted', 'agbVersion', 'acceptedPrivacyVersion', 'lastActivity', 'trustLevel', 'progressStage',
        'migrationComplete', 'userScore', 'conversionPotential', 'upsellSuggested', 'upsellAccepted',
        'upsellType', 'variantGroup', 'aiTriggeredUpsell'
      ]);
      allow delete: if false;
    }
    match /applications/{docId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['userId', 'jobTitle', 'company', 'jobUrl', 'status', 'applicationDate', 'notes', 'cvId', 'letterId']);
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['jobTitle', 'company', 'jobUrl', 'status', 'notes', 'cvId', 'letterId']);
    }
    match /progress/{userId} { allow read, write: if ownUser(userId); }
    match /feedback/{docId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
