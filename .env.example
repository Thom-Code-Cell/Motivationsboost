# Public Firebase web application configuration, taken from your Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional public settings:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# Server-only. Configure in the deployment dashboard, never in a public variable.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# In Google-hosted environments, Application Default Credentials can replace the
# service-account variables. The server account needs Auth and Firestore access.
GOOGLE_API_KEY=
GOOGLE_AI_MODEL=gemini-2.5-flash
GOOGLE_AI_IMAGE_MODEL=gemini-2.5-flash-image
GOOGLE_AI_TTS_MODEL=gemini-2.5-flash-preview-tts
ALLOWED_ADMIN_UIDS=
APP_URL=

# Leave disabled. Stripe is frozen until a separately tested Payrexx migration.
STRIPE_PAYMENTS_ENABLED=false
