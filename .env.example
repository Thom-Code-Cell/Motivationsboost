# PostgreSQL / Neon connection for the deployed app
DATABASE_URL=

# Better Auth, server-only. Generate a unique random secret with at least 32 bytes.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional AI provider. If unset, the app produces a clearly labelled guided draft.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra

# Local internal simulator only; npm run dev:internal sets the correct values.
INTERNAL_TEST_MODE=false
NEXT_PUBLIC_INTERNAL_TEST_MODE=false

# Payments remain disabled until sandbox verification is complete.
PAYREXX_PAYMENTS_ENABLED=false
PAYREXX_BILLING_VALIDATED=false
PAYREXX_WEBHOOK_ENABLED=false
PAYREXX_INSTANCE=
PAYREXX_API_KEY=
PAYREXX_WEBHOOK_SIGNING_KEY=

# Public site metadata only; set after the canonical domain is selected.
NEXT_PUBLIC_SITE_URL=
