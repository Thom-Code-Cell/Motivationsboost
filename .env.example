# Public Firebase web application configuration, taken from your Firebase project.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optional public settings:
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_GOOGLE_PICKER_API_KEY=
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=

# Server-only. Configure in the deployment dashboard, never in a public variable.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# In Google-hosted environments, Application Default Credentials can replace the
# service-account variables. The server account needs Auth and Firestore access.
OPENAI_API_KEY=
# Server only, never NEXT_PUBLIC_*
OPENAI_MODEL=gpt-5-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Remain false until per-user audio costs and budgets are implemented and tested.
OPENAI_AUDIO_BUDGET_VALIDATED=false
# Image editing remains disabled until budget approval
OPENAI_ENABLE_IMAGES=false
OPENAI_IMAGE_MODEL=gpt-image-1-mini
ALLOWED_ADMIN_UIDS=
APP_URL=

# Final verified canonical HTTPS domain will be configured after naming clearance.
NEXT_PUBLIC_SITE_URL=
PUBLIC_SITE_LAUNCHED=false

# Payrexx only – both switches MUST remain false until real sandbox payment, signed webhook,
# successful entitlement credit, failed payment, cancellation and refund tests have passed.
PAYREXX_PAYMENTS_ENABLED=false
PAYREXX_BILLING_VALIDATED=false
PAYREXX_INSTANCE=
PAYREXX_API_KEY=
PAYREXX_WEBHOOK_SIGNING_KEY=
# Preise werden zentral in src/lib/plans.ts gepflegt.
# Old Stripe routes are permanently disabled even if stale keys still exist in Vercel.

