# PostgreSQL / Neon connection for the deployed app
DATABASE_URL=

# Better Auth, server-only. Generate a unique random secret with at least 32 bytes.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Required for production email verification, password recovery, and account deletion.
RESEND_API_KEY=
EMAIL_TRANSPORT=
GOOGLE_APPS_SCRIPT_MAIL_URL=
GOOGLE_APPS_SCRIPT_MAIL_SECRET=
EMAIL_FROM=
EMAIL_REPLY_TO=
# Send sandbox payment notices only to this explicitly configured operator address.
PAYREXX_SANDBOX_NOTICE_RECIPIENT=
APP_URL=http://localhost:3000

# Optional AI provider. If unset, the app produces a clearly labelled guided draft.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.1-terra
# Optional per-function override. Only registered models with approved prices may run.
OPENAI_LETTER_MODEL=

# Local internal simulator only; npm run dev:internal sets the correct values.
INTERNAL_TEST_MODE=false
NEXT_PUBLIC_INTERNAL_TEST_MODE=false
NEXT_PUBLIC_EMAIL_VERIFICATION_REQUIRED=false
NEXT_PUBLIC_TRANSACTIONAL_EMAIL_ENABLED=false

# Payments remain disabled until sandbox verification is complete.
PAYREXX_PAYMENTS_ENABLED=false
PAYREXX_BILLING_VALIDATED=false
PAYREXX_WEBHOOK_ENABLED=false
PAYREXX_INSTANCE=
PAYREXX_API_KEY=
PAYREXX_WEBHOOK_SIGNING_KEY=

# Public site metadata only; set after the canonical domain is selected.
NEXT_PUBLIC_SITE_URL=

# Weekly checkout in Preview. Use only a provider already verified to be in Test mode inside PAYREXX_INSTANCE.
PAYREXX_WEEKLY_SANDBOX_ENTITLEMENTS_ENABLED=false
PAYREXX_SANDBOX_PSP_ID=
PAYREXX_SANDBOX_API_KEY=
PAYREXX_SANDBOX_WEBHOOK_SIGNING_KEY=
PAYREXX_SANDBOX_TERMS_VERSION=
# Optional explicit server-to-server sandbox reconciliation, only in protected Preview.
PAYREXX_SANDBOX_STATUS_POLLING=false
# Use an explicit pooled URL scoped only to the isolated Vercel preview branch.
MOTIVATIONS_NEON_BRANCH_PREVIEW=false
MOTIVATIONS_NEON_BRANCH_DATABASE_URL=
# Optional additional commercial monthly ceiling in CHF millionths. Purchase-backed caps always apply.
MOTIVATIONS_PRODUCT_AI_MONTHLY_LIMIT_MICROS=
